diff --git a/internal/order/validate.go b/internal/order/validate.go
new file mode 100644
index 0000000..a3e5ef2
--- /dev/null
+++ b/internal/order/validate.go
@@ -0,0 +1,45 @@
+// Package order holds the shared order-validation rules extracted
+// from the handlers.
+package order
+
+import (
+	"errors"
+	"fmt"
+
+	"shop/internal/model"
+)
+
+// Validate checks the common item rules shared by orders, returns,
+// and exchanges: email required, at least one item, and positive
+// quantities.
+func Validate(email string, items []model.Item) error {
+	if email == "" {
+		return errors.New("email is required")
+	}
+	if len(items) == 0 {
+		return errors.New("order must contain at least one item")
+	}
+	for _, it := range items {
+		if it.Qty <= 0 {
+			return fmt.Errorf("item %s: quantity must be positive", it.SKU)
+		}
+	}
+	return nil
+}
+
+// IsValid reports whether the common item rules pass.
+func IsValid(email string, items []model.Item) bool {
+	return Validate(email, items) == nil
+}
+
+// CheckTotal verifies a declared total equals the item sum.
+func CheckTotal(total int, items []model.Item) error {
+	computed := 0
+	for _, it := range items {
+		computed += it.Qty * it.Price
+	}
+	if computed != total {
+		return fmt.Errorf("order total %d does not match items %d", total, computed)
+	}
+	return nil
+}
diff --git a/internal/order/validate_test.go b/internal/order/validate_test.go
new file mode 100644
index 0000000..9f93092
--- /dev/null
+++ b/internal/order/validate_test.go
@@ -0,0 +1,33 @@
+package order
+
+import (
+	"testing"
+
+	"shop/internal/model"
+)
+
+func TestValidateFailures(t *testing.T) {
+	cases := []struct {
+		name  string
+		email string
+		items []model.Item
+	}{
+		{"empty email", "", []model.Item{{SKU: "a", Qty: 1, Price: 100}}},
+		{"no items", "a@b.co", nil},
+		{"zero qty", "a@b.co", []model.Item{{SKU: "a", Qty: 0, Price: 100}}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			if err := Validate(tc.email, tc.items); err == nil {
+				t.Fatal("expected validation error")
+			}
+		})
+	}
+}
+
+func TestValidateAccepts(t *testing.T) {
+	items := []model.Item{{SKU: "a", Qty: 2, Price: 100}}
+	if err := Validate("a@b.co", items); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+}
