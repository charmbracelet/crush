@@ -0,0 +1,24 @@
+package store
+
+import "testing"
+
+func TestGetMissIncrementsMisses(t *testing.T) {
+	s := New()
+	s.Get("absent")
+	hits, misses := s.Stats()
+	if misses != 1 || hits != 0 {
+		t.Fatalf("Stats() = %d hits, %d misses; want 0 hits, 1 miss", hits, misses)
+	}
+}
+
+func TestGetHitIncrementsHits(t *testing.T) {
+	s := New()
+	s.Set("sku-1", "widget")
+	if _, ok := s.Get("sku-1"); !ok {
+		t.Fatal("Get returned miss for a stored key")
+	}
+	hits, misses := s.Stats()
+	if hits != 1 || misses != 0 {
+		t.Fatalf("Stats() = %d hits, %d misses; want 1 hit, 0 misses", hits, misses)
+	}
+}
