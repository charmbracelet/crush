diff --git a/internal/client/client_test.go b/internal/client/client_test.go
new file mode 100644
index 0000000..73c81c9
--- /dev/null
+++ b/internal/client/client_test.go
@@ -0,0 +1,77 @@
+package client
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+
+	"fetcher/internal/config"
+)
+
+// dropConn fails the request at the transport layer by closing the
+// hijacked connection before writing a response.
+func dropConn(t *testing.T, w http.ResponseWriter) {
+	t.Helper()
+	hj, ok := w.(http.Hijacker)
+	if !ok {
+		t.Error("response writer cannot hijack")
+		return
+	}
+	conn, _, err := hj.Hijack()
+	if err != nil {
+		t.Error(err)
+		return
+	}
+	conn.Close()
+}
+
+func TestDoRetriesUntilSuccess(t *testing.T) {
+	var calls atomic.Int32
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		if calls.Add(1) == 1 {
+			dropConn(t, w)
+			return
+		}
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer srv.Close()
+
+	c := New(config.Config{Endpoint: srv.URL, Retries: 2})
+	// POST is not idempotent, so the transport does not silently retry
+	// — attempts come only from Do's own loop.
+	req, err := http.NewRequest(http.MethodPost, srv.URL+"/", strings.NewReader("x"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp, err := c.Do(req)
+	if err != nil {
+		t.Fatalf("Do: %v", err)
+	}
+	resp.Body.Close()
+	if got := calls.Load(); got != 2 {
+		t.Fatalf("server calls = %d, want 2", got)
+	}
+}
+
+func TestDoReturnsLastErrorWhenExhausted(t *testing.T) {
+	var calls atomic.Int32
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		calls.Add(1)
+		dropConn(t, w)
+	}))
+	defer srv.Close()
+
+	c := New(config.Config{Endpoint: srv.URL, Retries: 1})
+	req, err := http.NewRequest(http.MethodPost, srv.URL+"/", strings.NewReader("x"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := c.Do(req); err == nil {
+		t.Fatal("Do: expected error after exhausting attempts")
+	}
+	if got := calls.Load(); got != 2 {
+		t.Fatalf("server calls = %d, want 2 (initial + 1 retry)", got)
+	}
+}
